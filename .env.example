# Environment identity
CHECKIN_ENVIRONMENT=local
CHECKIN_CONTRACT_VERSION=1

# APISIX — non-secret endpoints and runtime references
APISIX_ADMIN_URL=https://apisix-admin.example.internal
APISIX_CONTROL_URL=https://apisix-control.example.internal
APISIX_GATEWAY_URL=https://checkin-gateway.example.internal
APISIX_OPEN_ROUTE=/webhook/checkin/open
APISIX_SUBMIT_ROUTE=/webhook/checkin/submit
N8N_UPSTREAM_URL=https://n8n.example.internal
N8N_API_URL=https://n8n.example.internal
N8N_SUBMIT_WORKFLOW_ID=000
MATTERMOST_EGRESS_CIDR=192.0.2.0/24
CHECKIN_TELEMETRY_URL=https://telemetry.example.internal/v1/apisix/checkin
RATE_LIMIT_REDIS_HOST=redis.example.internal
RATE_LIMIT_REDIS_PORT=6380

# Vault — secret values must never appear in this file
VAULT_ADDR=https://vault.example.internal
VAULT_KV_PATH=kv/n8n/mattermost/checkin
VAULT_AUTH_METHOD=workload_identity
VAULT_AUTH_MOUNT=jwt-nomad
VAULT_NOMAD_JWKS_CA_PEM_FILE=/secure/path/nomad-ca.pem

# Runtime service endpoints
BASEROW_API_URL=https://baserow.example.internal/api
BASEROW_CHECKINS_TABLE_ID=000
BASEROW_VIOLATIONS_TABLE_ID=000
BASEROW_VIOLATION_ID_FIELD_ID=000
BASEROW_DLQ_TABLE_ID=000
BASEROW_DLQ_ID_FIELD_ID=000
BASEROW_DLQ_REPLAY_VIEW_ID=000
CLICKHOUSE_HTTP_URL=https://clickhouse.example.internal:8443
CLICKHOUSE_DATABASE=checkin_analytics
SUPERSET_URL=https://superset.example.internal
COMPLIANCE_SOURCE_URL=https://compliance-source.example.internal
MATTERMOST_URL=https://mattermost.example.internal
CHECKIN_COMPLIANCE_SNAPSHOT_URL=https://compliance-source.example.internal/api/v1/checkin-compliance/snapshot
CHECKIN_WEEKLY_SNAPSHOT_URL=https://compliance-source.example.internal/api/v1/checkin-compliance/weekly-snapshot
CHECKIN_ANALYTICS_EXPECTATIONS_URL=https://compliance-source.example.internal/api/v1/checkin-compliance/expectations
CHECKIN_REPLAY_URL=https://n8n.example.internal/webhook/checkin/replay

# Dedicated n8n Code-task policy — no external packages are allowed
NODE_FUNCTION_ALLOW_BUILTIN=crypto
NODE_FUNCTION_ALLOW_EXTERNAL=
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Secret coordinates (names only; never set the values in this file)
APISIX_SECRET_OBJECT_REF=kv/n8n/mattermost/checkin/apisix
DIALOG_SHARED_SECRET_OBJECT_REF=kv/n8n/mattermost/checkin/dialog-shared
EVENT_SHARED_SECRET_OBJECT_REF=kv/n8n/mattermost/checkin/event-shared
OPEN_SECRET_OBJECT_REF=kv/n8n/mattermost/checkin/open
SUBMIT_SECRET_OBJECT_REF=kv/n8n/mattermost/checkin/submit
COMPLIANCE_SECRET_OBJECT_REF=kv/n8n/mattermost/checkin/compliance
DLQ_SECRET_OBJECT_REF=kv/n8n/mattermost/checkin/dlq
ANALYTICS_SECRET_OBJECT_REF=kv/n8n/mattermost/checkin/analytics

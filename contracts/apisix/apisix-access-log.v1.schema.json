{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acumen.internal/contracts/apisix-access-log.v1.schema.json",
  "title": "Sanitized APISIX Daily Check-in Access Log v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "logged_at",
    "route_id",
    "request_method",
    "status",
    "upstream_status",
    "latency_seconds",
    "correlation_id",
    "user_id",
    "outcome",
    "pod_id",
    "cycle_date",
    "checkin_type",
    "sla_code"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "logged_at": {"type": "string", "format": "date-time"},
    "route_id": {
      "type": "string",
      "enum": ["daily-checkin-open-v1", "daily-checkin-submit-v1"]
    },
    "request_method": {"const": "POST"},
    "status": {"type": "string", "pattern": "^[1-5][0-9]{2}$"},
    "upstream_status": {"type": "string", "pattern": "^([1-5][0-9]{2})?$"},
    "latency_seconds": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "correlation_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "user_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "outcome": {"type": "string", "enum": ["", "opened"]},
    "pod_id": {"type": "string", "maxLength": 128},
    "cycle_date": {"type": "string", "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"},
    "checkin_type": {"type": "string", "enum": ["", "SOD", "EOD", "ADHOC"]},
    "sla_code": {"type": "string", "maxLength": 128}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acumen.internal/contracts/compliance-snapshot.v1.schema.json",
  "title": "Compliance Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cycle_date",
    "roster_source_version",
    "roster",
    "sla_rules",
    "leave_records",
    "holidays",
    "checkins",
    "violations",
    "existing_action_ids"
  ],
  "properties": {
    "cycle_date": {"type": "string", "format": "date"},
    "now": {"type": "string", "format": "date-time"},
    "roster_source_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "roster": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user_id", "user_name", "pod_id", "timezone", "active", "mattermost_dm_channel_id", "pod_lead_channel_id"],
        "properties": {
          "user_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "user_name": {"type": "string", "minLength": 1, "maxLength": 200},
          "pod_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "timezone": {"type": "string", "minLength": 1, "maxLength": 100},
          "active": {"type": "boolean"},
          "active_from": {"type": "string", "format": "date"},
          "active_until": {"type": ["string", "null"], "format": "date"},
          "mattermost_dm_channel_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "pod_lead_channel_id": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    "sla_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkin_type", "sla_code", "local_due_time"],
        "properties": {
          "checkin_type": {"type": "string", "enum": ["SOD", "EOD"]},
          "sla_code": {"type": "string", "minLength": 1, "maxLength": 128},
          "local_due_time": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
          "pod_id": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    "leave_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user_id", "status", "start_date", "end_date"],
        "properties": {
          "user_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "status": {"type": "string", "enum": ["approved", "requested", "rejected", "cancelled"]},
          "start_date": {"type": "string", "format": "date"},
          "end_date": {"type": "string", "format": "date"}
        }
      }
    },
    "holidays": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "scope"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "scope": {"type": "string", "enum": ["global", "pod"]},
          "pod_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "source_version": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "allOf": [
          {
            "if": {"properties": {"scope": {"const": "pod"}}},
            "then": {"required": ["pod_id"]}
          }
        ]
      }
    },
    "checkins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkin_id", "user_id", "pod_id", "cycle_date", "checkin_type"],
        "properties": {
          "checkin_id": {"type": "string", "minLength": 8, "maxLength": 300},
          "user_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "pod_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "cycle_date": {"type": "string", "format": "date"},
          "checkin_type": {"type": "string", "enum": ["SOD", "EOD", "ADHOC"]},
          "submitted_at": {"type": "string", "format": "date-time"},
          "sla_status": {"type": "string", "enum": ["on_time", "late"]},
          "has_proof": {"type": "boolean"},
          "blocked_count": {"type": "integer", "minimum": 0, "maximum": 20}
        }
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["violation_id", "rule_id", "user_id", "pod_id", "cycle_date", "checkin_type", "status"],
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "violation_id": {"type": "string", "pattern": "^viol_[0-9a-f]{32}$"},
          "rule_id": {"const": "PI-6"},
          "user_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "pod_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "cycle_date": {"type": "string", "format": "date"},
          "checkin_type": {"const": "EOD"},
          "status": {"type": "string", "enum": ["open", "resolved", "waived"]}
        }
      }
    },
    "existing_action_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 8, "maxLength": 200},
      "uniqueItems": true,
      "maxItems": 10000
    }
  }
}

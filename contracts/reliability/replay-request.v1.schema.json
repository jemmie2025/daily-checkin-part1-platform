{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acumen.internal/contracts/replay-request.v1.schema.json",
  "title": "DLQ Replay Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["replay_key", "correlation_id", "failure_stage", "replay_steps", "raw_submission"],
  "properties": {
    "replay_key": {"type": "string", "minLength": 8, "maxLength": 300},
    "correlation_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "failure_stage": {
      "type": "string",
      "enum": ["baserow_checkins_write", "mattermost_canonical_post", "event_dispatch"]
    },
    "replay_steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["upsert_checkin", "verify_checkin", "ensure_canonical_post", "verify_canonical_post", "ensure_event"]
      }
    },
    "raw_submission": {"type": "string", "minLength": 1, "maxLength": 65536}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acumen.internal/contracts/checkin-dlq.v1.schema.json",
  "title": "checkin_dlq logical record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dlq_id",
    "replay_key",
    "source_workflow",
    "source_execution_id",
    "correlation_id",
    "user_id",
    "pod_id",
    "cycle_date",
    "checkin_type",
    "failure_stage",
    "attempt_count",
    "status",
    "last_error_code",
    "last_error_summary",
    "raw_submission",
    "created_at"
  ],
  "properties": {
    "dlq_id": {"type": "string", "minLength": 8, "maxLength": 300},
    "replay_key": {"type": "string", "minLength": 8, "maxLength": 300},
    "source_workflow": {"const": "checkin_submit_v1"},
    "source_execution_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "correlation_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "user_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "pod_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "cycle_date": {"type": "string", "format": "date"},
    "checkin_type": {"type": "string", "enum": ["SOD", "EOD", "ADHOC"]},
    "failure_stage": {
      "type": "string",
      "enum": ["baserow_checkins_write", "mattermost_canonical_post", "event_dispatch"]
    },
    "attempt_count": {"type": "integer", "minimum": 3},
    "status": {"type": "string", "enum": ["pending", "replaying", "resolved", "abandoned"]},
    "last_error_code": {"type": "string", "minLength": 1, "maxLength": 128},
    "last_error_summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "raw_submission": {"type": "string", "minLength": 1, "maxLength": 65536},
    "created_at": {"type": "string", "format": "date-time"},
    "next_retry_at": {"type": ["string", "null"], "format": "date-time"},
    "dm_notified_at": {"type": ["string", "null"], "format": "date-time"},
    "resolved_at": {"type": ["string", "null"], "format": "date-time"},
    "resolved_checkin_id": {"type": ["string", "null"], "maxLength": 300},
    "replay_started_at": {"type": ["string", "null"], "format": "date-time"},
    "replay_owner": {"type": ["string", "null"], "maxLength": 128},
    "replay_attempt_count": {"type": "integer", "minimum": 0},
    "retention_delete_after": {"type": ["string", "null"], "format": "date-time"}
  }
}

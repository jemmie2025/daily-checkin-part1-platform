{
  "classification": "secret-coordinates-only",
  "kv_mount": "kv",
  "kv_version": 2,
  "logical_prefix": "n8n/mattermost/checkin",
  "schema_version": 1,
  "secret_objects": [
    {
      "consumers": [
        "n8n-analytics"
      ],
      "keys": [
        "clickhouse_ingest_key",
        "clickhouse_ingest_user",
        "roster_read_token"
      ],
      "path": "kv/n8n/mattermost/checkin/analytics"
    },
    {
      "consumers": [
        "apisix"
      ],
      "keys": [
        "redis_password",
        "telemetry_auth_header"
      ],
      "path": "kv/n8n/mattermost/checkin/apisix"
    },
    {
      "consumers": [
        "n8n-compliance"
      ],
      "keys": [
        "baserow_violations_token",
        "calendar_read_token",
        "mattermost_bot_token",
        "roster_read_token"
      ],
      "path": "kv/n8n/mattermost/checkin/compliance"
    },
    {
      "consumers": [
        "n8n-open",
        "n8n-submit"
      ],
      "keys": [
        "state_signing_key"
      ],
      "path": "kv/n8n/mattermost/checkin/dialog-shared"
    },
    {
      "consumers": [
        "n8n-dlq"
      ],
      "keys": [
        "baserow_dlq_token",
        "mattermost_bot_token",
        "n8n_execution_read_token",
        "replay_token"
      ],
      "path": "kv/n8n/mattermost/checkin/dlq"
    },
    {
      "consumers": [
        "n8n-analytics",
        "n8n-submit"
      ],
      "keys": [
        "event_ingest_token"
      ],
      "path": "kv/n8n/mattermost/checkin/event-shared"
    },
    {
      "consumers": [
        "n8n-open"
      ],
      "keys": [
        "compliance_sla_read_token",
        "mattermost_bot_token",
        "mattermost_command_token"
      ],
      "path": "kv/n8n/mattermost/checkin/open"
    },
    {
      "consumers": [
        "n8n-submit"
      ],
      "keys": [
        "baserow_checkins_token",
        "mattermost_bot_token",
        "mattermost_submit_signature"
      ],
      "path": "kv/n8n/mattermost/checkin/submit"
    }
  ],
  "workloads": [
    {
      "name": "apisix",
      "owner": "platform-gateway",
      "policy_name": "daily-checkin-apisix",
      "role_name": "daily-checkin-apisix",
      "rotation_days": 90
    },
    {
      "name": "n8n-analytics",
      "owner": "data-platform",
      "policy_name": "daily-checkin-n8n-analytics",
      "role_name": "daily-checkin-n8n-analytics",
      "rotation_days": 90
    },
    {
      "name": "n8n-compliance",
      "owner": "compliance-automation",
      "policy_name": "daily-checkin-n8n-compliance",
      "role_name": "daily-checkin-n8n-compliance",
      "rotation_days": 90
    },
    {
      "name": "n8n-dlq",
      "owner": "platform-operations",
      "policy_name": "daily-checkin-n8n-dlq",
      "role_name": "daily-checkin-n8n-dlq",
      "rotation_days": 90
    },
    {
      "name": "n8n-open",
      "owner": "checkin-backend",
      "policy_name": "daily-checkin-n8n-open",
      "role_name": "daily-checkin-n8n-open",
      "rotation_days": 90
    },
    {
      "name": "n8n-submit",
      "owner": "checkin-backend",
      "policy_name": "daily-checkin-n8n-submit",
      "role_name": "daily-checkin-n8n-submit",
      "rotation_days": 90
    }
  ]
}
